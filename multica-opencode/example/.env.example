# ----------------------------------------------------------------------------
# Multica runtime container configuration.
# Copy to `.env` and fill in. Everything except MULTICA_TOKEN is optional.
# ----------------------------------------------------------------------------

# --- Required ---------------------------------------------------------------

# Multica personal access token (Settings -> API Tokens; starts with `mul_`).
# Created at https://multica.ai/settings?tab=tokens (Cloud) or in your
# self-hosted web app. 90-day validity; the daemon renews it automatically.
MULTICA_TOKEN=

# --- Server endpoint (self-hosted only; empty = Multica Cloud) --------------

# MULTICA_SERVER_URL=http://localhost:8080
# MULTICA_APP_URL=http://localhost:3000

# --- Scaling ----------------------------------------------------------------

# Number of runtime containers started by `docker compose up -d`
# (docker compose up -d --scale runtime=N overrides this).
MULTICA_RUNTIME_REPLICAS=1

# --- Instance identity ------------------------------------------------------

# Daemon id / device name default to the hostname (= container ID, unique per
# replica). Set MULTICA_DAEMON_DEVICE_NAME for a single instance, or the
# prefix for a fleet (each replica registers as PREFIX-<container suffix>).
# MULTICA_DEVICE_NAME_PREFIX=agent
# MULTICA_DAEMON_ID=runtime-1
# MULTICA_DAEMON_DEVICE_NAME=runtime-1
# MULTICA_AGENT_RUNTIME_NAME=Docker runtime

# --- opencode (LLM access) --------------------------------------------------

# Provider keys are passed through to task-spawned opencode processes
# automatically (no entrypoint wiring by design). Provide at least one.
# KIMI_API_KEY is the Kimi For Coding plan; MOONSHOT_API_KEY is pay-as-you-go
# Kimi models from the Moonshot platform.
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
# KIMI_API_KEY=
# MISTRAL_API_KEY=
# MOONSHOT_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# XAI_API_KEY=
# Z.AI Coding Plan (the same key is valid for the regular Z.AI API):
# ZHIPU_API_KEY=

# Model override for tasks dispatched to opencode (provider/model), e.g.
# anthropic/claude-sonnet-4-5, zai-coding-plan/glm-5.3, kimi-for-coding/k3
# MULTICA_OPENCODE_MODEL=

# --- Git identity (agent commits) -------------------------------------------

GIT_USER_NAME=multica-agent
GIT_USER_EMAIL=agent@example.com

# --- Git repository access --------------------------------------------------

# Option A — HTTPS token (GIT_HOST defaults to github.com):
# GIT_HTTPS_TOKEN=ghp_xxxxxxxxxxxx
# GIT_HOST=github.com
# GIT_HTTPS_USER=x-access-token
#
# Option B — SSH key: mount it read-only in docker-compose.yml
#   ./secrets/id_ed25519:/home/agent/.ssh/id_ed25519:ro
# (or point GIT_SSH_KEY at another mounted path)

# --- TLS (self-signed certificates) -----------------------------------------

# Mount the CA cert in docker-compose.yml (./secrets/ca.crt:/certs/ca.crt:ro),
# then point the consumers you need at it:
# SSL_CERT_FILE=/certs/ca.crt         (multica daemon; replaces the system bundle)
# NODE_EXTRA_CA_CERTS=/certs/ca.crt   (opencode / LLM endpoints)
# GIT_SSL_CAINFO=/certs/ca.crt        (git over HTTPS)

# --- Daemon tuning (optional) -----------------------------------------------

# MULTICA_DAEMON_MAX_CONCURRENT_TASKS=20
# MULTICA_DAEMON_POLL_INTERVAL=30s
# MULTICA_DAEMON_PORT=19514

# --- Image (optional) -------------------------------------------------------

# Local tag built from the repo (see README -> Build) or a registry image:
# MULTICA_RUNTIME_IMAGE=ghcr.io/yourorg/multica-opencode-runtime:0.4.36-1
