# ---------------------------------------------------------------------------
# Multica runtime container configuration.
# Copy to `.env` and fill in. Everything except MULTICA_TOKEN is optional.
# ---------------------------------------------------------------------------

# --- Required ---------------------------------------------------------------

# Multica personal access token (Settings -> API Tokens; starts with `mul_`).
# Created at https://multica.ai/settings?tab=tokens (Cloud) or in your
# self-hosted web app. 90-day validity; the daemon renews it automatically.
MULTICA_TOKEN=

# --- Server endpoint (self-hosted only; leave empty for Multica Cloud) ------

# MULTICA_SERVER_URL=http://localhost:8080
# MULTICA_APP_URL=http://localhost:3000

# --- Scaling ------------------------------------------------------------------

# Number of runtime containers started by `docker compose up -d`
# (docker compose up -d --scale runtime=N overrides this).
MULTICA_RUNTIME_REPLICAS=2

# --- Instance identity -------------------------------------------------------
# Defaults: daemon id / device name = hostname (= container ID, unique per
# replica). Override only if you want stable human-readable names.
# MULTICA_DAEMON_ID=runtime-1
# MULTICA_DAEMON_DEVICE_NAME=runtime-1
# MULTICA_AGENT_RUNTIME_NAME=Docker runtime

# --- opencode (LLM access) ----------------------------------------------------
# Provide at least one provider key; opencode picks standard env keys up
# automatically. Pass only the ones you need.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=
# XAI_API_KEY=
# Model override for tasks dispatched to opencode (provider/model):
# MULTICA_OPENCODE_MODEL=anthropic/claude-sonnet-4-5

# --- Git identity (agent commits) --------------------------------------------
GIT_USER_NAME=multica-agent
GIT_USER_EMAIL=agent@example.com

# --- Git repository access ----------------------------------------------------
# Option A — HTTPS token (GIT_HOST defaults to github.com):
# GIT_HTTPS_TOKEN=ghp_xxxxxxxxxxxx
# GIT_HOST=github.com
# GIT_HTTPS_USER=x-access-token
#
# Option B — SSH key: mount it read-only in docker-compose.yml
#   ./secrets/id_ed25519:/home/agent/.ssh/id_ed25519:ro
# (or point GIT_SSH_KEY at another mounted path)

# --- Daemon tuning (optional) -------------------------------------------------
# MULTICA_DAEMON_MAX_CONCURRENT_TASKS=20
# MULTICA_DAEMON_POLL_INTERVAL=30s
# MULTICA_DAEMON_PORT=19514

# --- Image (optional) ----------------------------------------------------------
# Local tag built from the repo (see README -> Build) or a registry image:
# MULTICA_RUNTIME_IMAGE=ghcr.io/yourorg/multica-runtime:0.4.36
